# ==========================================
# NEUROCORE 360 - VARIABLES D'ENVIRONNEMENT
# ==========================================

# ===== OBLIGATOIRE =====

# Base de donnees PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Auth (OBLIGATOIRE en production - refuse de demarrer sans)
SESSION_SECRET=your_strong_random_secret_here

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SECRET_KEY_FR=sk_live_xxx
STRIPE_WEBHOOK_SECRET_FR=whsec_xxx
STRIPE_ENABLE_KLARNA=true

# Admin
ADMIN_SECRET=your_admin_secret
ADMIN_EMAILS=admin@example.com

# AI Engines (au moins un obligatoire)
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=AIzaxxx
OPENAI_API_KEY=sk-xxx

# ===== OPTIONNEL =====

# Serveur
PORT=5000
NODE_ENV=production
SENTRY_DSN=
VITE_SENTRY_DSN=

# URLs publiques
APP_URL=https://apexlabs.achzodcoaching.com
RENDER_EXTERNAL_URL=https://apexlabs.achzodcoaching.com
PUBLIC_BASE_URL=https://apexlabs.achzodcoaching.com

# AI Model config
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-6
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=8000
GEMINI_MODEL=gemini-2.0-flash-exp
BLOOD_ANALYSIS_MODEL=claude-opus-4-6

# Stripe price IDs (OBLIGATOIRE - copier depuis Stripe Dashboard > Products)
VITE_STRIPE_PRICE_ANABOLIC=price_xxx
VITE_STRIPE_PRICE_ULTIMATE=price_xxx
BLOOD_ANALYSIS_PRICE_ID=price_xxx
VITE_STRIPE_PRICE_BLOOD_ANALYSIS=price_xxx

# Mode de livraison: instant | delayed
DELIVERY_MODE=instant

# Blood Analysis
DEFAULT_BLOOD_CREDITS=5
BLOOD_ANALYSIS_FAST_MODE=false
BLOOD_ANALYSIS_PARALLEL_SECTIONS=true
BLOOD_AI_SYNC_TIMEOUT_MS=120000
BLOOD_AI_ASYNC_TIMEOUT_MS=2700000

# Discovery automation (fail-closed until every switch and ISO cutoff are set)
DISCOVERY_TRANSACTIONAL_AUTOMATION_ENABLED=false
DISCOVERY_AUTOMATION_START_AT=
DISCOVERY_UNIFIED_GENERATION_ENABLED=false
DISCOVERY_REPORT_DELIVERY_ENABLED=false
DISCOVERY_BATCH_DELIVERY_WORKER_ENABLED=false
DISCOVERY_SENT_REMEDIATION_ENABLED=false
REMEDIATION_SIDE_EFFECTS_DISABLED=true
AI_COST_DISCOVERY_PER_AUDIT_USD=0.75
AI_COST_DISCOVERY_PER_HOUR_USD=1.50
AI_COST_DISCOVERY_PER_DAY_USD=5.00

# Email (SendPulse)
SENDPULSE_ID=
SENDPULSE_SECRET=
SENDPULSE_SENDER_EMAIL=coaching@achzodcoaching.com
SENDPULSE_SENDER_NAME=APEXLABS
SENDER_NAME=APEXLABS
SMTP_HOST=smtp-pulse.com
SMTP_PORT=587
SMTP_FROM_EMAIL=coaching@achzodcoaching.com
SMTP_USER=
SMTP_PASS=

# Désinscription en un clic (List-Unsubscribe, RFC 8058)
# Secret de signature des liens. Optionnel : sans lui, une clé dérivée de
# SESSION_SECRET est utilisée. Le changer invalide les liens déjà envoyés.
LIST_UNSUBSCRIBE_SECRET=
# Adresse du lien mailto de l'en-tête (défaut coaching@achzodcoaching.com)
LIST_UNSUBSCRIBE_MAILTO=
# Base des liens (défaut PUBLIC_BASE_URL, puis APP_URL), doit être en HTTPS
LIST_UNSUBSCRIBE_BASE_URL=
# 1 = les mails marketing et séquences passent par le relais SMTP (SMTP_HOST)
# pour porter les en-têtes List-Unsubscribe ; l'API REST SendPulse ne permet
# pas d'en-têtes personnalisés. Défaut : désactivé.
EMAIL_MARKETING_VIA_SMTP_RELAY=0

# Frontend
VITE_ADMIN_KEY=

# Conversion Tracking (Meta Ads + Google Ads)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Analytics 4 (plus simple que Google Ads API)
GA4_PROPERTY_ID=
GA4_API_KEY=

# Peptides Engine : option 2 Peptides EU (lien affilie). Optionnel, sinon la constante de server/peptidesEuSource.ts est utilisee.
PEPTIDES_EU_AFFILIATE_URL=https://www.peptides-eu.net/?aff=AFF-F6AKX33F
PEPTIDES_EU_CODE=AFF-F6AKX33F
