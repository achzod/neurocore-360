# ==========================================
# NEUROCORE 360 - VARIABLES D'ENVIRONNEMENT
# ==========================================

# ===== OBLIGATOIRE =====

# Base de donnees PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database

# Auth (OBLIGATOIRE en production - refuse de demarrer sans)
SESSION_SECRET=your_strong_random_secret_here

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Admin
ADMIN_SECRET=your_admin_secret
ADMIN_EMAILS=admin@example.com

# AI Engines (au moins un obligatoire)
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=AIzaxxx
OPENAI_API_KEY=sk-xxx

# ===== OPTIONNEL =====

# Serveur
PORT=5000
NODE_ENV=production
SENTRY_DSN=
VITE_SENTRY_DSN=

# URLs publiques
APP_URL=https://apexlabs.achzodcoaching.com
RENDER_EXTERNAL_URL=https://apexlabs.achzodcoaching.com
PUBLIC_BASE_URL=https://apexlabs.achzodcoaching.com

# AI Model config
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-6
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=8000
GEMINI_MODEL=gemini-2.0-flash-exp
BLOOD_ANALYSIS_MODEL=claude-opus-4-6

# Stripe price IDs (OBLIGATOIRE - copier depuis Stripe Dashboard > Products)
VITE_STRIPE_PRICE_ANABOLIC=price_xxx
VITE_STRIPE_PRICE_ULTIMATE=price_xxx
BLOOD_ANALYSIS_PRICE_ID=price_xxx
VITE_STRIPE_PRICE_BLOOD_ANALYSIS=price_xxx

# Mode de livraison: instant | delayed
DELIVERY_MODE=instant

# Blood Analysis
DEFAULT_BLOOD_CREDITS=5
BLOOD_ANALYSIS_FAST_MODE=false
BLOOD_ANALYSIS_PARALLEL_SECTIONS=true
BLOOD_AI_SYNC_TIMEOUT_MS=120000
BLOOD_AI_ASYNC_TIMEOUT_MS=2700000

# Email (SendPulse)
SENDPULSE_ID=
SENDPULSE_SECRET=
SENDPULSE_SENDER_EMAIL=coaching@achzodcoaching.com
SENDPULSE_SENDER_NAME=NEUROCORE 360
SMTP_HOST=smtp-pulse.com
SMTP_PORT=587
SMTP_FROM_EMAIL=coaching@achzodcoaching.com
SMTP_USER=
SMTP_PASS=

# Frontend
VITE_ADMIN_KEY=

# Conversion Tracking (Meta Ads + Google Ads)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Analytics 4 (plus simple que Google Ads API)
GA4_PROPERTY_ID=
GA4_API_KEY=
